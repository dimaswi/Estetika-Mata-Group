# Pemetaan Port Host VPS (Mengikuti urutan dr-aryo & ikami agar tidak bentrok)
# dr-aryo : Frontend 3000 | Backend 8080 | DB 5434
# ikami   : Frontend 3001 | Backend 8081 | DB 5435
# emg     : Frontend 3002 | Backend 8082 | DB 5436
FRONTEND_PORT=3002
BACKEND_PORT=8082
DB_PORT=5436

# Kredensial Database PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GantiPasswordDatabaseProduction123!
POSTGRES_DB=estetika_mata_db

# Secret JWT & Domain Production (pisahkan dengan koma jika lebih dari satu)
JWT_SECRET=GantiDenganSecretRandomMinimal32KarakterProduction!
CORS_ALLOWED_ORIGINS=https://domain-anda.com,https://www.domain-anda.com,http://localhost:3002

# Opsional: Token Cloudflare Tunnel (jika menggunakan `docker compose --profile cloudflare up -d`)
CLOUDFLARE_TUNNEL_TOKEN=
