# Port aplikasi yang diekspos ke host/server
APP_PORT=8080

# Kredensial Database PostgreSQL (Container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GantiPasswordDatabaseProduction123!
POSTGRES_DB=starterkit

# Secret JWT & Domain Production (pisahkan dengan koma jika lebih dari satu)
JWT_SECRET=GantiDenganSecretRandomMinimal32KarakterProduction!
CORS_ALLOWED_ORIGINS=https://domain-anda.com,https://www.domain-anda.com
