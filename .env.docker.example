# Port aplikasi di host VPS (dr-aryo memakai 3000, ikami memakai 3001 -> EMG memakai 3002)
APP_PORT=3002

# Kredensial Database PostgreSQL (Container terisolasi di emg-internal-network, tidak ekspos port 5432 ke host)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GantiPasswordDatabaseProduction123!
POSTGRES_DB=estetika_mata_db

# Secret JWT & Domain Production (pisahkan dengan koma jika lebih dari satu)
JWT_SECRET=GantiDenganSecretRandomMinimal32KarakterProduction!
CORS_ALLOWED_ORIGINS=https://domain-anda.com,https://www.domain-anda.com

# Opsional: Token Cloudflare Tunnel (jika menjalankan dengan `--profile cloudflare`)
CLOUDFLARE_TUNNEL_TOKEN=
